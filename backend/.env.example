APP_NAME=BrandGuard Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://brandguard:brandguard@localhost:5432/brandguard
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / OIDC
SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=brandguard-assets
S3_REGION=us-east-1

# External Integration Adapters
AI_INTEGRATION_URL=http://localhost:8001
AI_INTEGRATION_TIMEOUT_SECONDS=30
CHECKER_ENGINE_URL=http://localhost:8002

